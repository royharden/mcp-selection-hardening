{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:mcpsh:conformance-evidence:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "probe_id", "track", "scope", "request_sha256", "source_pins", "session", "frames", "observation", "checks", "record_sha256", "semantic", "requirements"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "probe_id": {"$ref": "evidence-v2.schema.json#/properties/probe_id"}, "track": {"$ref": "evidence-v2.schema.json#/properties/track"},
    "scope": {"$ref": "evidence-v2.schema.json#/properties/scope"}, "request_sha256": {"$ref": "evidence-v2.schema.json#/properties/request_sha256"},
    "source_pins": {"$ref": "evidence-v2.schema.json#/properties/source_pins"}, "session": {"$ref": "evidence-v2.schema.json#/properties/session"},
    "frames": {"type": "array"}, "observation": {"$ref": "evidence-v2.schema.json#/properties/observation"},
    "checks": {"$ref": "evidence-v2.schema.json#/properties/checks"}, "record_sha256": {"$ref": "evidence-v2.schema.json#/properties/record_sha256"},
    "semantic": {"$ref": "evidence-v2.schema.json#/properties/semantic"},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["inventory_version", "inventory_sha256", "requirement_ids", "required_scope"],
      "properties": {"inventory_version": {"const": "m5-conformance-boundaries-v1"}, "inventory_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "requirement_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
        "required_scope": {"enum": ["actual-memory", "actual-posix", "actual-stdio"]}}},
    "frame_rule": {"description": "Optional versioned rule; declared broker-control probes bind their control receipt in place of frames. Absent: original v3 frame rules.",
      "type": "object", "additionalProperties": false,
      "required": ["rule", "probe_id", "track", "evidence_scope", "error_code", "receipt", "receipt_sha256", "identity"],
      "properties": {"rule": {"enum": ["m5-broker-control-receipt-v1"]},
        "probe_id": {"enum": ["read-amplification"]}, "track": {"enum": ["synthetic-memory", "filesystem-posix"]},
        "evidence_scope": {"const": "actual-owned-broker-budget"}, "error_code": {"type": ["string", "null"], "maxLength": 64},
        "receipt": {"type": "object", "minProperties": 1}, "receipt_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "identity": {"type": "object", "additionalProperties": false,
          "required": ["approval_id", "conformance_session_id", "server_instance_id", "trial_id", "child_pid", "broker_pid", "broker_epoch", "fixture_id", "fixture_payload_sha256", "sequence"],
          "properties": {"approval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "conformance_session_id": {"type": "string", "minLength": 1, "maxLength": 256}, "server_instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "trial_id": {"type": "string", "minLength": 1, "maxLength": 256}, "child_pid": {"type": "integer", "minimum": 1},
            "broker_pid": {"type": "integer", "minimum": 1}, "broker_epoch": {"type": "string", "minLength": 1, "maxLength": 256},
            "fixture_id": {"type": "string", "minLength": 1, "maxLength": 256}, "fixture_payload_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
            "sequence": {"type": "integer", "minimum": 1}}}}}
  },
  "if": {"required": ["frame_rule"]},
  "then": {"properties": {"frames": {"type": "array", "maxItems": 0}}},
  "else": {"properties": {"frames": {"$ref": "evidence-v2.schema.json#/properties/frames"}}}
}
