{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpsh:conformance-evidence:v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "probe_id", "track", "scope", "request_sha256", "source_pins", "session", "frames", "observation", "checks", "record_sha256", "semantic"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "probe_id": {"$ref": "evidence-v1.schema.json#/properties/probe_id"},
    "track": {"$ref": "evidence-v1.schema.json#/properties/track"},
    "scope": {"$ref": "evidence-v1.schema.json#/properties/scope"},
    "request_sha256": {"$ref": "evidence-v1.schema.json#/properties/request_sha256"},
    "source_pins": {"$ref": "evidence-v1.schema.json#/properties/source_pins"},
    "session": {"$ref": "evidence-v1.schema.json#/properties/session"},
    "frames": {"$ref": "evidence-v1.schema.json#/properties/frames"},
    "observation": {"$ref": "evidence-v1.schema.json#/properties/observation"},
    "checks": {"$ref": "evidence-v1.schema.json#/properties/checks"},
    "record_sha256": {"$ref": "evidence-v1.schema.json#/properties/record_sha256"},
    "semantic": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "manifest_version", "case_source_sha256", "grammar_version", "parser_version", "grammar_source_sha256", "parser_source_sha256", "case_id", "case_call_sha256", "case_expectation_sha256", "actual_raw_arguments_sha256", "handler_result_sha256", "coverage_sha256", "coverage_kind"],
      "properties": {
        "manifest_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "manifest_version": {"const": "m5-required-conformance-v1"},
        "case_source_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "grammar_version": {"const": "m5-literal-pattern-v1"}, "parser_version": {"const": "m5-log-fields-v1"},
        "grammar_source_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "parser_source_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "case_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "case_call_sha256": {"$ref": "#/$defs/nullableSha"},
        "case_expectation_sha256": {"$ref": "#/$defs/nullableSha"},
        "actual_raw_arguments_sha256": {"$ref": "#/$defs/nullableSha"},
        "handler_result_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "coverage_sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"},
        "coverage_kind": {"enum": ["parsed", "validation-refusal", "unknown", "not-applicable-control"]}
      }
    }
  },
  "$defs": {"nullableSha": {"anyOf": [{"$ref": "evidence-v1.schema.json#/$defs/sha256"}, {"type": "null"}]}}
}
