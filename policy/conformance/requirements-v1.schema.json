{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:mcpsh:conformance-requirements:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "inventory_version", "source_plan", "proof_scopes", "requirements"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "inventory_version": {"const": "m5-conformance-boundaries-v1"},
    "source_plan": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "requirement", "sections"],
      "properties": {"path": {"const": "planning/promoted/Plan_M5_Selected_v1.md"}, "sha256": {"$ref": "evidence-v1.schema.json#/$defs/sha256"}, "requirement": {"const": "M5-04"}, "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [2, 3, 4, 6]}}}},
    "proof_scopes": {"type": "object", "additionalProperties": false, "required": ["synthetic-memory", "filesystem-posix", "stdio"],
      "properties": {"synthetic-memory": {"const": "actual-memory"}, "filesystem-posix": {"const": "actual-posix"}, "stdio": {"const": "actual-stdio"}}},
    "requirements": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "citation", "tracks", "probe_ids", "expectation"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96}, "citation": {"type": "string", "minLength": 1, "maxLength": 256},
        "tracks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["synthetic-memory", "filesystem-posix", "stdio"]}},
        "probe_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "expectation": {"type": "object", "additionalProperties": false, "required": ["kind", "metric", "maximum", "unit"], "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 96}, "metric": {"type": ["string", "null"], "minLength": 1, "maxLength": 96},
          "maximum": {"type": ["integer", "null"], "minimum": 1, "maximum": 8388608}, "unit": {"enum": [null, "bytes", "lines", "seconds", "characters", "calls", "rules", "sources"]}}}
      }
    }}
  }
}
