[build-system]
requires = ["hatchling>=1.26,<2"]
build-backend = "hatchling.build"

[project]
name = "mcp-selection-hardening"
version = "0.1.0"
description = "A synthetic MCP metadata-selection and independent-enforcement research harness"
requires-python = ">=3.12"
license = "MIT"
dependencies = ["pydantic>=2.9,<3"]

[project.optional-dependencies]
dev = ["pytest>=8,<10", "ruff>=0.9,<1"]

[project.scripts]
mcpsh = "mcpsh.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/mcpsh"]

[tool.ruff]
target-version = "py312"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
